# Variables d'environnement pour le projet IoT Hackathon

# MQTT Configuration
MQTT_BROKER=mosquitto
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://backend:8000
DEBUG=true

# Dashboard
DASHBOARD_PORT=8501

# Database SQLite
DATABASE_PATH=/app/data/readings.db
DATABASE_URL=sqlite:///app/data/readings.db

# Machine Learning
ML_MODEL_PATH=/app/data/models
ANOMALY_THRESHOLD=0.8

# Data Sources
OPENDATA_URL=https://archive.ics.uci.edu/ml/machine-learning-databases/00601/ai4i2020.csv

# Simulation Parameters
SIMULATION_SPEED=1.0
MAX_MACHINES=3
FAILURE_RATE=0.1

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/application.log