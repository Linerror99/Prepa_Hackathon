# Variables d'environnement pour le projet IoT Hackathon

# MQTT Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# Dashboard
DASHBOARD_PORT=8501

# Machine Learning
ML_MODEL_PATH=./ml/models
ANOMALY_THRESHOLD=0.8

# Data Sources
OPENDATA_URL=https://archive.ics.uci.edu/ml/machine-learning-databases/00601/ai4i2020.csv
NASA_TURBOFAN_URL=https://ti.arc.nasa.gov/tech/dash/groups/pcoe/prognostic-data-repository/publications/

# Simulation Parameters
SIMULATION_SPEED=1.0
MAX_MACHINES=5
FAILURE_RATE=0.1

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/application.log